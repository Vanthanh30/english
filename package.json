{
  "name": "english-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Gamified English learning platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace @english-quest/api",
    "dev:web": "npm run dev --workspace @english-quest/web",
    "format": "npm run format --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace @english-quest/api -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace @english-quest/api",
    "prisma:generate": "npm run prisma:generate --workspace @english-quest/api",
    "prisma:push": "npm run prisma:push --workspace @english-quest/api",
    "prisma:studio": "npm run prisma:studio --workspace @english-quest/api",
    "seed": "npm run seed --workspace @english-quest/api",
    "infra:up": "docker compose up -d mongodb redis",
    "infra:down": "docker compose down"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
